# --- Core ---
NODE_ENV=development
PORT=3001

# --- Banco (docker-compose local) ---
DATABASE_URL=postgresql://vcd:vcd_local@localhost:5432/vcd?schema=public

# --- Redis (filas BullMQ, cache, SSE pub/sub) ---
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO local; Cloudflare R2 em prod — mesmo SDK S3) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=vcd
S3_SECRET_KEY=vcd_local_minio
S3_BUCKET_AUDIO=vcd-audio
S3_BUCKET_CARDS=vcd-cards
S3_BUCKET_EXPORTS=vcd-exports

# --- Auth ---
JWT_ACCESS_SECRET=dev-only-change-me
JWT_ACCESS_TTL=900s
REFRESH_TOKEN_TTL_DAYS=60

# --- Criptografia do caderno (envelope) ---
# Em produção: SOMENTE via secret manager do Railway. Nunca commitar.
JOURNAL_MASTER_KEY=dev-only-32-bytes-base64-change-me
JOURNAL_MASTER_KEY_VERSION=1

# --- Integrações (vazio em dev até as fases respectivas) ---
ANTHROPIC_API_KEY=
GOOGLE_TTS_CREDENTIALS_JSON=
OPENAI_MODERATION_API_KEY=
REVENUECAT_WEBHOOK_AUTH=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FCM_SERVICE_ACCOUNT_JSON=

# --- Email (Mailpit local) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@voceconhecedeus.local

# --- Observabilidade ---
SENTRY_DSN=
